        <!-- Chart bars -->
        <rect x="8" y="14.4" width="2.56" height="11.2" fill="#0d9488" rx="0.64"/>
        <rect x="12.16" y="11.2" width="2.56" height="14.4" fill="#0d9488" rx="0.64"/>
        <rect x="16.32" y="8" width="2.56" height="17.6" fill="#0d9488" rx="0.64"/>
        <rect x="20.48" y="4.8" width="2.56" height="20.8" fill="#0d9488" rx="0.64"/>

        <!-- Trend line -->
        <polyline
          points="9.28,16 13.44,12.8 17.6,9.6 21.76,6.4"
          fill="none"
          stroke="#f59e0b"
