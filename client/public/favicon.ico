
    <svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
      <!-- Background -->
      <rect width="32" height="32" fill="#ffffff" rx="4.8"/>

      <!-- Medical cross (simplified) -->
