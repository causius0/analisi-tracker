{
  "name": "analisi-tracker",
  "version": "2.0.0",
  "description": "Advanced medical lab test analytics platform with AI-powered insights, trend analysis, correlation detection, and predictive analytics",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "vitest",
    "test:api": "jest tests/api",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config=vitest.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:ai": "node scripts/test-ai-api.js",
    "lint": "eslint .",
    "db:migrate": "node scripts/db-migrate.js apply",
    "db:migrate:generate": "node scripts/db-migrate.js generate",
    "db:migrate:status": "node scripts/db-migrate.js status",
    "db:seed": "node server/db/seeds/seed.js",
    "db:studio": "drizzle-kit studio",
    "process:pdfs": "node scripts/process-pdfs.js"
  },
  "keywords": [
    "medical",
    "analytics",
    "ai",
    "lab-tests",
    "health-tracking",
    "trend-analysis",
    "predictive-analytics",
    "llm",
    "chat",
    "pdf-extraction",
    "rag"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^10.47.0",
    "@sentry/profiling-node": "^10.47.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.54.0",
    "nodemon": "^3.0.1",
    "vitest": "^4.1.3"
  }
}
